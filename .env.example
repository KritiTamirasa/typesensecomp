# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` (repo root). The backend and the seed
# script both read it. The frontend has its own frontend/.env.
# ─────────────────────────────────────────────────────────────

# --- Typesense (matches docker-compose.yml) ---
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz

# --- Vision provider: auto | mock | anthropic | openai | gemini ---
# "auto" uses whichever API key is present, else falls back to "mock".
VISION_PROVIDER=auto

# Provide ONE of these to use a real vision model (optional).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_VISION_MODEL=claude-opus-5
# OPENAI_API_KEY=sk-...
# OPENAI_VISION_MODEL=gpt-4o-mini
# GEMINI_API_KEY=...
# GEMINI_VISION_MODEL=gemini-1.5-flash

# --- Geo fallback when the browser blocks geolocation (Bangalore) ---
FALLBACK_LAT=12.9716
FALLBACK_LNG=77.5946

# --- CORS (frontend dev origin) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
